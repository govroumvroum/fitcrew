# Error tracking — self-hosted Rustrak (Sentry-protocol compatible).
# The DSN is a public ingest key, so it is safe to commit and identical in both.
# The client bundle inlines the NEXT_PUBLIC_ one; the server, and the edge
# runtime behind Clerk's proxy, read SENTRY_DSN (falling back to the public one).
NEXT_PUBLIC_SENTRY_DSN=https://5895a37eed7e4b9e97ac4b6e04368cfe@rustrack.bazlab.si/6
SENTRY_DSN=https://5895a37eed7e4b9e97ac4b6e04368cfe@rustrack.bazlab.si/6
