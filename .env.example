# Error tracking — self-hosted Rustrak (Sentry-protocol compatible).
# The DSN is a public ingest key, so it is safe to commit. The NEXT_PUBLIC_
# prefix is what lets the value be inlined into the client bundle; Next also
# exposes it to the Node and edge runtimes, which read the same name
# (src/instrumentation.ts).
NEXT_PUBLIC_SENTRY_DSN=https://5895a37eed7e4b9e97ac4b6e04368cfe@rustrack.bazlab.si/6

# Optional override for the release tag every event and session carries. Unset,
# the build uses Vercel's commit SHA and falls back to the short git SHA
# locally (see next.config.ts).
# SENTRY_RELEASE=

# Source map upload — build-time only. The plugin reads these while `next build`
# runs, so a variable set only on the running container comes too late and the
# upload is skipped silently. `SENTRY_URL` must point at Rustrak (the DSN above
# only routes events) and `SENTRY_PROJECT` must be the dashboard slug, or the
# upload assembles against a 404. `SENTRY_AUTH_TOKEN` is an upload-only token
# from Settings → API Tokens; never commit its value.
SENTRY_URL=https://rustrack.bazlab.si
SENTRY_PROJECT=fitcrew
# SENTRY_AUTH_TOKEN=
